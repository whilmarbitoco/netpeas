#!/usr/bin/env bash
#
# NetPEAS v1.0 — Main entry point
#

set -Eeuo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

source "${SCRIPT_DIR}/lib/colors.sh"
source "${SCRIPT_DIR}/lib/utils.sh"
source "${SCRIPT_DIR}/lib/tools.sh"

source "${SCRIPT_DIR}/core/args.sh"
source "${SCRIPT_DIR}/core/executor.sh"
source "${SCRIPT_DIR}/core/discovery.sh"
source "${SCRIPT_DIR}/core/scheduler.sh"
source "${SCRIPT_DIR}/core/findings.sh"

main() {
    peas_parse_args "$@" || exit $?

    echo ""
    echo -e "${CYAN}╔══════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║  NetPEAS v1.0 — Network Enum & Triage  ║${NC}"
    echo -e "${CYAN}╚══════════════════════════════════════════╝${NC}"

    local state_dir
    if [[ -n "$STATE_DIR" ]]; then
        mkdir -p "$STATE_DIR"
        state_dir="$STATE_DIR"
    else
        state_dir="$(peas_mktemp_dir)"
    fi

    trap "peas_cleanup '$state_dir'" EXIT INT TERM

    peas_info "Workspace: $state_dir"
    peas_info "Mode: $MODE"

    peas_detect_tools || exit 1

    peas_discover_services "${TARGETS[0]}" "$state_dir"

    peas_schedule_modules "${state_dir}/services.txt" "$state_dir"

    peas_section "Intelligence"
    peas_render_findings
    peas_render_summary "${#TARGETS[@]}" "$(wc -l < "${state_dir}/services.txt" 2>/dev/null || echo 0)"

    peas_info "Scan complete"
}

main "$@"
